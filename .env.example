# Application URL (http://localhost:3000 locally or https://tensor-bot-beta.vercel.app in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YugabyteDB Cloud (PostgreSQL Vector + Native Auth)
YUGABYTE_DATABASE_URL=postgresql://user:password@host:5433/yugabyte
YUGABYTE_SSL=true

# Firecrawl Web Crawler API Key
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Meko MCP Agent Memory
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=your_meko_api_key
MEKO_DATAPACK=tensor-bot-knowledge
MEKO_RECALL_TOOL=recall
MEKO_WRITE_TOOL=write

# Gemini / Google AI Studio Key
GEMINI_API_KEY=your_gemini_api_key

# Optional Groq Key
GROQ_API_KEY=

# Supabase (Optional fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=

